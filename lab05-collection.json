          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Урьдач нөхцөл дутуугийн статус 200 байна', function () { pm.response.to.have.status(200); });", "pm.test('ERROR_PREREQUISITES буцна', function () { pm.expect(pm.response.json().result).to.eql('ERROR_PREREQUISITES'); });", "pm.test('missing нь CS201 агуулна', function () { pm.expect(pm.response.json().missing).to.include('CS201'); });"] } }]
        }
      ]
    },
    {
