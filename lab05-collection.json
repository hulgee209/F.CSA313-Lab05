{
  "info": {
    "_postman_id": "b5683a3a-8d02-45fc-bff2-a1b4ddc54d51",
    "name": "Lab05 - Registration API PASS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "01 - Идэвхтэй оюутан урьдач нөхцөлийг хангаад амжилттай бүртгүүлнэ",
      "item": [
        {
          "name": "Setup - Идэвхтэй оюутан CS201 үзсэн",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\"CS201\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/students/S-HAPPY" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Setup student status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Setup student result is OK', function () { pm.expect(pm.response.json().result).to.eql('OK'); });"] } }]
        },
        {
          "name": "Setup - CS201 урьдачтай хичээл",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"prerequisites\": [\"CS201\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/courses/C-HAPPY" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Setup course status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Setup course result is OK', function () { pm.expect(pm.response.json().result).to.eql('OK'); });"] } }]
        },
        {
          "name": "POST - Амжилттай бүртгүүлэх",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"studentID\": \"S-HAPPY\",\n  \"courseID\": \"C-HAPPY\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/registrations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Амжилттай бүртгэл 201 байна', function () { pm.response.to.have.status(201); });", "pm.test('Result OK байна', function () { pm.expect(pm.response.json().result).to.eql('OK'); });", "pm.test('registrationID нь тоо байна', function () { pm.expect(pm.response.json().registrationID).to.be.a('number'); });"] } }]
        }
      ]
    },
    {
      "name": "02 - Байхгүй оюутан ERROR_NO_STUDENT авна",
      "item": [
        {
          "name": "Setup - Хичээл үүсгэх",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"prerequisites\": [] }", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/courses/C-NO-STUDENT" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Setup status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Setup result is OK', function () { pm.expect(pm.response.json().result).to.eql('OK'); });"] } }]
        },
        {
          "name": "POST - Байхгүй оюутан",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"studentID\": \"S-NOT-FOUND\", \"courseID\": \"C-NO-STUDENT\" }", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/registrations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Байхгүй оюутны статус 200 байна', function () { pm.response.to.have.status(200); });", "pm.test('ERROR_NO_STUDENT буцна', function () { pm.expect(pm.response.json().result).to.eql('ERROR_NO_STUDENT'); });"] } }]
        }
      ]
    },
